# Parent directory. The downloader creates $DATAPATH/Lahner2024Bold.
DATAPATH=/data/studies
SAVEPATH=/scratch/$USER/spfcl
SPFCL_CACHE=/scratch/$USER/spfcl/cache
SPFCL_OUTPUT=/scratch/$USER/spfcl/outputs
HF_HOME=/scratch/$USER/spfcl/huggingface

# CUDA wheel channel used by scripts/bootstrap_remote.sh.
# Change cu124 if it does not match the server driver/toolchain.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# Optional experiment tracking.
WANDB_MODE=offline
WANDB_ENTITY=

# Never commit the stimulus password. It is only read by install-stimuli.
# Prefer setting this interactively with `read -s`; an empty value is harmless.
BMD_STIMULI_PASSWORD=

# Slurm defaults; override on the server.
SLURM_PARTITION=
SLURM_CONSTRAINT=
